# Copy to .env.production and fill in the VPS address. This file is shell-sourced.
DEPLOY_HOST=your-vps-hostname-or-ip
DEPLOY_USER=caddy-deploy
# DEPLOY_SSH_KEY=/absolute/path/to/private/key
# Caddy deployments keep the deployed GHCR image unless this names another one.
# CADDY_IMAGE=ghcr.io/dvinubius/hetzner-one-caddy@sha256:<digest>
# Set an independent platform Grafana password; this file is ignored by Git.
GRAFANA_ADMIN_PASSWORD='replace-with-a-password-of-at-least-20-characters'
