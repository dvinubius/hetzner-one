{
  "uid": "hetzner-caddy",
  "title": "Hetzner-One \u00b7 Caddy",
  "description": "Shared ingress only. Top-level subroute metrics count each HTTPS request once. No raw paths, client IPs, or per-key rate-limit metrics. Guide: docs/observability-guide.md.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "hetzner-one"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "Mean requests per second over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "4xx share",
      "description": "Share of responses with a 4xx status over the selected time range. Scanners and rate limiting raise it; it has no universal healthy value.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\",code=~\"4..\"}[$__range])) or vector(0)) / sum(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx share",
      "description": "Share of responses with a 5xx status over the selected time range, from upstreams and Caddy alike.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\",code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Middleware errors",
      "description": "Errors raised inside Caddy over the selected time range: unreachable upstreams, rate and body limits, missing gallery files. A status an app returns is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(caddy_http_request_errors_total{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Data sent",
      "description": "Response body bytes sent to clients over the selected time range, after compression. Excludes headers and TLS overhead.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(caddy_http_response_size_bytes_sum{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "In flight now",
      "description": "Requests Caddy is handling at the last scrape, including open Hooklook event streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(caddy_http_requests_in_flight{job=\"caddy\",handler=\"subroute\",host=~\"$host\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests by site",
      "description": "One top-level subroute sample per HTTPS request in the pinned build; excludes metrics listener and redirects.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Uses histogram count because requests_total lacks the status label.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,status_class)(label_replace(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval]),\"status_class\",\"${1}xx\",\"code\",\"([1-5])[0-9][0-9]\"))",
          "legendFormat": "{{host}} {{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "4xx and 5xx responses",
      "description": "Includes upstream responses and Caddy-generated rejection responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\",code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "502 and 504 responses",
      "description": "Traffic-based upstream failure indicator; use together with external health checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\",code=~\"502|504\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "413 and 429 responses (5m)",
      "description": "Validated locally with controlled Caddy rejections. Not zone-specific; upstreams can return these codes too. 431 parser rejections require a separate synthetic check.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"$host\",code=~\"413|429\"}[5m]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Middleware errors by site",
      "description": "Errors raised inside Caddy: unreachable upstream (502), upstream timeout (504), rate limit (429), body limit (413), and missing files on the gallery (404). A status an app returns itself, such as its own 500 or 404, is not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_request_errors_total{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Reverse-proxy upstream state",
      "description": "Caddy internal state; no active health checks are configured, so 1 is not proof the upstream is reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "caddy_reverse_proxy_upstreams_healthy{job=\"caddy\"}",
          "legendFormat": "{{upstream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Caddy scrape availability",
      "description": "Scrape availability only; verify HTTPS separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"caddy\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
