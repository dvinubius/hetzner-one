        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 request duration",
      "description": "Full request duration, from request to last byte. Hooklook event streams last until the client leaves and land above the 10 s top bucket, pulling p95 up; compare with p95 time to first byte.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(host,le)(rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval])))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "p95 time to first byte",
      "description": "Time until the handler chain writes the response header. Unaffected by long streams. Caddy-generated error responses and client aborts record no sample.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(host,le)(rate(caddy_http_response_duration_seconds_bucket{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval])))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Data transfer rate",
      "description": "Inbound (up) is Caddy's estimate from request headers and Content-Length; chunked uploads are undercounted and rejected bodies are still counted. Outbound (down) is response body bytes after compression, excluding headers and TLS.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_request_size_bytes_sum{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}} in"
        },
        {
          "refId": "B",
          "expr": "sum by(host)(rate(caddy_http_response_size_bytes_sum{job=\"caddy\",handler=\"subroute\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* out$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 16,
      "type": "timeseries",
