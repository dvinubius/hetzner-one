{
  "uid": "hetzner-caddy",
  "title": "Hetzner-One \u00b7 Caddy",
  "description": "Shared ingress only. Top-level subroute metrics count each HTTPS request once. No raw paths, client IPs, or per-key rate-limit metrics.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "hetzner-one"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Caddy scrape availability",
      "description": "Scrape availability only; verify HTTPS separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"caddy\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by site",
      "description": "One top-level subroute sample per HTTPS request in the pinned build; excludes metrics listener and redirects.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Uses histogram count because requests_total lacks the status label.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,status_class)(label_replace(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval]),\"status_class\",\"$1xx\",\"code\",\"([1-5])[0-9][0-9]\"))",
          "legendFormat": "{{host}} {{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4xx and 5xx responses",
      "description": "Includes upstream responses and Caddy-generated rejection responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\",code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p95 request latency",
      "description": "Full request duration; no value until traffic has been observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(host,le)(rate(caddy_http_request_duration_seconds_bucket{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval])))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mean request size",
      "description": "Includes request headers; rejected bodies may not be fully consumed.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_request_size_bytes_sum{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval])) / sum by(host)(rate(caddy_http_request_size_bytes_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Mean response size",
      "description": "Response bytes emitted to the client.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host)(rate(caddy_http_response_size_bytes_sum{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval])) / sum by(host)(rate(caddy_http_response_size_bytes_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\"}[$__rate_interval]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "413 and 429 responses (5m)",
      "description": "Validated locally with controlled Caddy rejections. Not zone-specific; upstreams can return these codes too. 431 parser rejections require a separate synthetic check.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(increase(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\",code=~\"413|429\"}[5m]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reverse-proxy upstream state",
      "description": "Caddy internal state; no active health checks are configured, so 1 is not proof the upstream is reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "caddy_reverse_proxy_upstreams_healthy{job=\"caddy\"}",
          "legendFormat": "{{upstream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "502 and 504 responses",
      "description": "Traffic-based upstream failure indicator; use together with external health checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "hetzner-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host,code)(rate(caddy_http_request_duration_seconds_count{job=\"caddy\",handler=\"subroute\",host=~\"zibs.app|hooklook.app|art-gallery.dinubarbu.com\",code=~\"502|504\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
