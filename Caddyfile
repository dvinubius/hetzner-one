{
	metrics {
		per_host
	}
	# This listener is shared by every HTTPS host below. A larger header block is
	# rejected by Caddy before it can reach any upstream service. Go's HTTP/1.1
	# parser adds a 4 KiB read-buffer allowance, so this setting's observed
	# rejection boundary is approximately 36 KiB.
	servers :443 {
		max_header_size 32KiB
	}
}

# Caddy obtains and renews TLS certificates after public DNS and ports 80/443
# point to this host.
zibs.app {
	encode zstd gzip

	# Grafana externally shared dashboards use this page, its deliberately
	# anonymous dashboard API, and these public static assets. Do not proxy the
	# broader Grafana UI or its general /api surface.
	# Caddy joins both edge networks, and Compose gives each app's Grafana the
	# alias "grafana" on its edge network, so a bare "grafana" upstream is
	# ambiguous. Dial the Zibs container by its Compose container name.
	@public_grafana path /public-dashboards/* /api/public/dashboards/* /public/build/* /public/img/* /favicon.ico
	handle @public_grafana {
		reverse_proxy zibs-grafana-1:3000
	}

	# Do not let Grafana workspace routes fall through to the public app. They
	# are neither needed by an externally shared dashboard nor safe to expose;
	# returning here also keeps scans and misrouted browser requests out of
	# zibs's request logs and metrics.
	@grafana_private_or_probe path /api/datasources/* /api/v1/* /config/v1/* /dashboards /dashboards/* /grafana /grafana/* /grafana-* /log-grafana-javascript-agent /login /public/plugins/* /rules
	handle @grafana_private_or_probe {
		respond 404
	}

	handle {
		reverse_proxy zibs:8080
	}
}

# Static generative-art gallery. `browse` supplies the directory-index UI for
# artwork directories which deliberately do not contain an index.html file.
art-gallery.dinubarbu.com {
	root * /srv/art-gallery
	encode zstd gzip
	file_server browse
}

hooklook.app {
	encode zstd gzip

	# caddy-ratelimit uses sliding windows, not a token bucket. The two capture
	# windows therefore express both the 60/minute sustained budget and a strict
	# maximum burst of 20 requests in any 20-second window. {remote_host} is the
	# direct socket peer; this intentionally does not trust forwarded headers.
	route {
		rate_limit {
			# Keep client IPs out of the metrics registry and scrape response.
			disable_metrics
			zone hooklook_create {
				match {
					method GET
					path /
				}
				key {remote_host}
				events 20
				window 1m
			}

			zone hooklook_capture_sustained {
				match {
					path_regexp hooklook_capture ^/b/[^/]+(?:/.*)?$
				}
				key {remote_host}
				events 60
				window 1m
			}

			zone hooklook_capture_burst {
				match {
					path_regexp hooklook_capture_burst ^/b/[^/]+(?:/.*)?$
				}
				key {remote_host}
				events 20
				window 20s
			}
		}

		# Hooklook's externally shared Grafana dashboard: the same narrow
		# allowlist as zibs.app. None of these paths is a Hooklook route, and no
		# rate-limit zone above matches them. Hooklook's Compose file gives its
		# Grafana the unique alias hooklook-grafana on hooklook-edge.
		@hooklook_public_grafana path /public-dashboards/* /api/public/dashboards/* /public/build/* /public/img/* /favicon.ico
		handle @hooklook_public_grafana {
			reverse_proxy hooklook-grafana:3000
		}

		# Restrict bodies only on public capture URLs. Inspector pages, APIs, and
		# SSE remain unmodified by this handler.
		@hooklook_capture path_regexp hooklook_capture_route ^/b/[^/]+(?:/.*)?$
		handle @hooklook_capture {
			request_body {
				max_size 10MB
			}
			reverse_proxy hooklook:8080
		}

		handle {
			reverse_proxy hooklook:8080
		}
	}
}

saga.dinubarbu.com {
	encode zstd gzip

	# Keyed on the direct socket peer, as for hooklook.app. The submission zone
	# is one budget shared by every form and JSON API POST.
	route {
		rate_limit {
			disable_metrics
			zone saga_lab_submit {
				match {
					method POST
					path /transfers /top-ups /reset /api/*
				}
				key {remote_host}
				events 20
				window 1m
			}

			zone saga_lab_grafana {
				match {
					path /grafana/*
				}
				key {remote_host}
				events 300
				window 1m
			}
		}

		# Saga Lab's whole Grafana UI, unlike the public-dashboard allowlists
		# above: its Trace link passes a traceId variable, which an externally
		# shared dashboard cannot take, so visitors use Grafana's anonymous
		# Viewer role. Grafana serves from this sub-path, so the prefix is kept;
		# Grafana Live's WebSocket upgrade passes through reverse_proxy. Saga
		# Lab's Compose file sets both aliases on saga-lab-edge.
		handle /grafana/* {
			reverse_proxy saga-lab-grafana:3000
		}

		handle {
			reverse_proxy saga-lab:8080
		}
	}
}

# Private scrape listener. No host publication; admin remains on localhost:2019.
http://:9180 {
	handle /metrics {
		metrics
	}
	handle {
		respond 404
	}
}
